{
	"name": "mini-claude-code",
	"version": "1.0.1",
	"type": "module",
	"private": false,
	"description": "A small local terminal Code Agent powered by Bun and AI SDK.",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"bin": {
		"minicc": "./bin/minicc.cjs"
	},
	"files": [
		"bin/minicc.cjs",
		"dist/index.js",
		"README.md"
	],
	"scripts": {
		"start": "bun src/index.ts",
		"build": "bun build src/index.ts --target=bun --outfile dist/index.js",
		"build:binary": "bun build src/index.ts --compile --outfile dist/minicc",
		"link:global": "bun run build && npm link",
		"prepack": "bun run build",
		"test": "bun test"
	},
	"devDependencies": {
		"@ai-sdk/deepseek": "^2.0.34",
		"@ai-sdk/openai": "^3.0.63",
		"@types/bun": "latest",
		"@types/node": "^25.8.0",
		"ai": "^6.0.177",
		"typescript": "^5",
		"zod": "^4.4.3"
	},
	"dependencies": {
		"chalk": "^5.6.2"
	}
}
